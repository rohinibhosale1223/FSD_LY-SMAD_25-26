<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="about-container galaxy-background">
  <div class="container py-5">
    <div class="text-center mb-5" data-aos="fade-up">
      <h1 class="neon-text">ABOUT CRITICAL HIT</h1>
      <p class="neon-subtext">Your Ultimate Destination for Game Reviews</p>
    </div>
    
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="glass-card mb-5" data-aos="fade-up">
          <h2 class="neon-text">Our Mission</h2>
          <p class="neon-subtext">
            At Critical Hit, we believe that gaming is more than just entertainment—it's an art form, a community, 
            and a way to push the boundaries of technology and storytelling. Our mission is to provide gamers with 
            honest, in-depth reviews that help them discover their next favorite game.
          </p>
        </div>
        
        <div class="glass-card mb-5" data-aos="fade-up" data-aos-delay="100">
          <h2 class="neon-text">Why Critical Hit?</h2>
          <div class="row">
            <div class="col-md-6">
              <div class="feature-box">
                <h4 class="neon-text"><i class="neon-icon">🎮</i> Expert Reviews</h4>
                <p class="neon-subtext">Written by passionate gamers and industry experts with years of experience.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="feature-box">
                <h4 class="neon-text"><i class="neon-icon">⚡</i> Real-Time Updates</h4>
                <p class="neon-subtext">Stay informed with the latest news, updates, and reviews as they happen.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="feature-box">
                <h4 class="neon-text"><i class="neon-icon">👥</i> Community Driven</h4>
                <p class="neon-subtext">Join thousands of gamers sharing their experiences and opinions.</p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="feature-box">
                <h4 class="neon-text"><i class="neon-icon">🔮</i> Futuristic Experience</h4>
                <p class="neon-subtext">Experience our cutting-edge platform designed for the modern gamer.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="glass-card" data-aos="fade-up" data-aos-delay="200">
          <h2 class="neon-text">Join Our Community</h2>
          <p class="neon-subtext">
            Become part of our growing community of gamers, reviewers, and enthusiasts. Share your thoughts, 
            discover new games, and connect with fellow players who share your passion.
          </p>
          <div class="mt-4">
            <a href="/register" class="btn neon-button me-2">Sign Up Now</a>
            <a href="/reviews" class="btn neon-button-secondary">Browse Reviews</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>