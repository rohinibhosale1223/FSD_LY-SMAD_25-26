<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BingeBox - Home</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #121212;
      color: #fff;
    }
    .navbar-brand {
      color: #e50914 !important;
      font-weight: bold;
    }
    .btn-danger {
      background-color: #e50914;
      border: none;
    }
    .btn-danger:hover {
      background-color: #f6121d;
    }
    h2 {
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">BingeBox</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/movies">Movies</a></li>
          <li class="nav-item"><a class="nav-link" href="#">TV Shows</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="text-center py-5">
    <h1 class="display-4 text-danger">Unlimited Movies, TV Shows & More</h1>
    <p class="lead">Watch anywhere. Cancel anytime.</p>
    <button id="startBtn" class="btn btn-danger btn-lg mt-3">Start Watching</button>
  </header>

  <!-- Featured Movies (hidden initially) -->
  <div id="movieGrid" class="container my-5" style="display: none;">
    <h2 class="mb-4">Popular on BingeBox</h2>
    <div class="row">
      <div class="col-md-3 mb-3">
        <img src="/Images/movie1.jpg" class="img-fluid rounded" alt="Movie 1">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie2.jpg" class="img-fluid rounded" alt="Movie 2">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie3.jpg" class="img-fluid rounded" alt="Movie 3">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie4.jpg" class="img-fluid rounded" alt="Movie 4">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie5.jpg" class="img-fluid rounded" alt="Movie 5">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie6.jpg" class="img-fluid rounded" alt="Movie 6">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie7.jpg" class="img-fluid rounded" alt="Movie 7">
      </div>
      <div class="col-md-3 mb-3">
        <img src="/Images/movie8.jpg" class="img-fluid rounded" alt="Movie 8">
      </div>
    </div>
  </div>

  <!-- JavaScript to show movie grid on button click -->
  <script>
    const startBtn = document.getElementById('startBtn');
    const movieGrid = document.getElementById('movieGrid');

    startBtn.addEventListener('click', () => {
      movieGrid.style.display = 'block'; // Show movie grid
      startBtn.style.display = 'none';   // Hide Start Watching button
    });
  </script>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Footer -->
<footer class="bg-black text-light py-4 mt-5">
  <div class="container">
    <div class="row">
      
      <!-- About Us -->
      <div class="col-md-6 mb-3">
        <h5>About BingeBox</h5>
        <p>Your go-to streaming platform for movies and TV shows. Watch anywhere, anytime, on any device.</p>
      </div>
      
      <!-- Copyright -->
      <div class="col-md-6 text-md-end mb-3">
        <p>&copy; 2025 BingeBox. All rights reserved.</p>
      </div>
      
    </div>
  </div>
</footer>

</body>
</html>
