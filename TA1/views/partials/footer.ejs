  <script>
    async function checkAuthStatus() {
      try {
        const response = await fetch('/api/auth/check');
        const result = await response.json();
        if (result.loggedIn) {
          document.getElementById('authLinks')?.style && (document.getElementById('authLinks').style.display = 'none');
          document.getElementById('registerLink')?.style && (document.getElementById('registerLink').style.display = 'none');
          const dd = document.getElementById('userDropdown');
          if (dd) dd.style.display = 'block';
          const un = document.getElementById('userName');
          if (un) un.textContent = result.user.first_name || result.user.username;
        } else {
          document.getElementById('authLinks')?.style && (document.getElementById('authLinks').style.display = 'block');
          document.getElementById('registerLink')?.style && (document.getElementById('registerLink').style.display = 'block');
          const dd = document.getElementById('userDropdown');
          if (dd) dd.style.display = 'none';
        }
      } catch (e) {
        // ignore
      }
    }
    async function logout() {
      try {
        const res = await fetch('/api/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const j = await res.json();
        if (j.success) window.location.reload();
      } catch (e) {}
    }
    function editProfile(){ window.location.href = '/dashboard'; }
    document.addEventListener('DOMContentLoaded', () => checkAuthStatus());
  </script>
