<div class="auth-container"><div class="auth-card"><div class="auth-header"><h2><i class="fas fa-user-plus me-2"></i>Join MTANKS</h2><p>Create your account and start your journey</p></div><div class="auth-body"><div id="alertContainer"></div><form id="registerForm"><div class="form-row"><div class="form-floating"><input class="form-control" id="firstName" placeholder="First Name" required><label for="firstName">First Name</label></div><div class="form-floating"><input class="form-control" id="lastName" placeholder="Last Name" required><label for="lastName">Last Name</label></div></div><div class="form-floating"><input class="form-control" id="username" placeholder="Username" required><label for="username">Username</label></div><div class="form-floating"><input type="email" class="form-control" id="email" placeholder="Email" required><label for="email">Email</label></div><div class="form-floating position-relative"><input type="password" class="form-control" id="password" placeholder="Password" required><label for="password">Password</label></div><div class="form-floating position-relative"><input type="password" class="form-control" id="confirmPassword" placeholder="Confirm Password" required><label for="confirmPassword">Confirm Password</label></div><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="terms" required><label class="form-check-label" for="terms">Agree to terms</label></div><button class="btn btn-primary w-100" type="submit">Create Account</button></form></div></div></div>
